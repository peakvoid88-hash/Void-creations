<button class="btn btn-primary" id="submitButton" type="submit">SEND PROJECT ENQUIRY <span class="arrow">↗</span></button>
<p aria-live="polite" id="formNote" style="font-size:12px;color:#b5b5b5;line-height:1.6;margin:0">Your message will be sent securely through Formspree.</p>
