<div class="contact-shortcuts reveal"><a href="mailto:shopstore2357@gmail.com?subject=Project%20enquiry%20%E2%80%94%20Void%20Creations">EMAIL ME ↗</a><a href="https://wa.me/94752688640" rel="noopener noreferrer" target="_blank">WHATSAPP ↗</a><a href="#contactForm">HIRE ME ↗</a></div></section>
</main>
<footer class="footer"><a class="footer-brand" href="#home">VOID CREATIONS</a><span>INDEPENDENT DIGITAL STUDIO</span><a href="#home">BACK TO TOP ↑</a><span>© <span id="year"></span> VOID CREATIONS. MADE WITH INTENTION.</span></footer>
<script>
const menu=document.querySelector('.menu'),links=document.querySelector('.navlinks');
// Scroll-driven logo reveal: only the logo recedes into the dark; all text stays readable.
const hero=document.querySelector('.hero');
const logoVisual=document.querySelector('.hero-visual');
const logoStage=document.querySelector('.logo-stage');
const heroCopy=document.querySelector('.hero-copy-wrap');
let scrollTick=false;
function updateIntro(){
  const rect=hero.getBoundingClientRect();
  const range=Math.max(1,hero.offsetHeight-window.innerHeight);
  const progress=Math.min(1,Math.max(0,(-rect.top)/range));
  const eased=progress*progress*(3-2*progress);
  if(logoStage){
    const scale=1-(eased*.72);
    const translateY=eased*-90;
    logoStage.style.transform=`translate3d(0,${translateY}px,0) scale(${scale})`;
    logoStage.style.opacity=String(1-eased);
    logoStage.style.filter=`blur(${eased*5}px)`;
    logoStage.style.animationPlayState=progress>.02?'paused':'running';
  }
  // Keep the hero copy and all header/navigation text unchanged and fully readable.
  scrollTick=false;
}
window.addEventListener('scroll',()=>{if(!scrollTick){window.requestAnimationFrame(updateIntro);scrollTick=true}},{passive:true});
window.addEventListener('resize',updateIntro);
updateIntro();
menu.addEventListener('click',()=>{const open=links.classList.toggle('open');menu.setAttribute('aria-expanded',String(open));menu.textContent=open?'×':'☰'});
links.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{links.classList.remove('open');menu.setAttribute('aria-expanded','false');menu.textContent='☰'}));
const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('visible');observer.unobserve(entry.target)}}),{threshold:.12});
document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));
document.getElementById('year').textContent=new Date().getFullYear();
document.getElementById('contactForm').addEventListener('submit',async e=>{
 e.preventDefault();
 const form=e.currentTarget;
 const note=document.getElementById('formNote');
 const button=document.getElementById('submitButton');
 const originalButton=button.innerHTML;
 button.disabled=true;
 button.innerHTML='SENDING…';
 note.textContent='Sending your enquiry…';
 try{
   const response=await fetch(form.action,{
     method:'POST',
     body:new FormData(form),
     headers:{'Accept':'application/json'}
   });
   if(response.ok){
     note.textContent='Thanks — your enquiry has been sent. We’ll be in touch soon.';
     form.reset();
   }else{
     let message='We couldn’t send your message right now. Please try again or email shopstore2357@gmail.com.';
     try{const result=await response.json();if(result.errors)message=result.errors.map(error=>error.message).join(' ')}catch(_){}
     note.textContent=message;
   }
 }catch(error){
   note.textContent='Connection issue — please try again or email shopstore2357@gmail.com.';
 }finally{
   button.disabled=false;
   button.innerHTML=originalButton;
 }
});
</script>
</body>
</html>
